<Window
    x:Class="SmartSearch.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmartSearch.Desktop"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Smart Search">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <muxc:NavigationView x:Name="RootNavigation"
                         PaneDisplayMode="Auto"
                         OpenPaneLength="232"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         SelectionChanged="OnNavigationSelectionChanged">
      <muxc:NavigationView.Header>
        <Grid ColumnSpacing="12" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="WorkspaceTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="FeedbackButton" IsEnabled="False">
              <SymbolIcon x:Name="FeedbackIcon" Symbol="Message" />
              <Button.Flyout>
                <Flyout x:Name="FeedbackFlyout" Placement="BottomEdgeAlignedRight">
                  <StackPanel Spacing="12" Width="340">
                    <Grid ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="FeedbackHeading" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Button x:Name="ClearFeedbackButton" Grid.Column="1" Click="OnClearFeedbackClick" />
                    </Grid>
                    <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <StackPanel Spacing="8">
                        <TextBlock x:Name="FeedbackTitle" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="FeedbackMessage" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                      </StackPanel>
                    </ScrollViewer>
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="RefreshWorkspaceButton" Click="OnRefreshWorkspaceClick">
              <SymbolIcon Symbol="Refresh" />
            </Button>
          </StackPanel>
        </Grid>
      </muxc:NavigationView.Header>
      <muxc:NavigationView.PaneHeader>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,12,12,16">
          <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Width="36" Height="36" Padding="2">
            <Image x:Name="AppLogo" Source="ms-appx:///Assets/smart-search.png" Stretch="Uniform" AutomationProperties.Name="Smart Search" />
          </Border>
          <TextBlock Text="Smart Search" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>
      </muxc:NavigationView.PaneHeader>
      <muxc:NavigationView.MenuItems>
        <muxc:NavigationViewItem Content="概览" Tag="overview" IsSelected="True">
          <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="服务商" Tag="providers">
          <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="搜索与研究" Tag="search">
          <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="活动" Tag="activity">
          <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="AI 接入" Tag="ai">
          <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Remote" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
        <muxc:NavigationViewItem Content="设置与关于" Tag="settings">
          <muxc:NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></muxc:NavigationViewItem.Icon>
        </muxc:NavigationViewItem>
      </muxc:NavigationView.MenuItems>
      <Frame x:Name="ContentFrame" Background="{ThemeResource LayerFillColorDefaultBrush}" />
    </muxc:NavigationView>
  </Grid>
</Window>
