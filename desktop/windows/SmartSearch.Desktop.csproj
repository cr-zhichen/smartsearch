<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SmartSearch.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\smart-search.ico</ApplicationIcon>
    <Product>Smart Search</Product>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LocalizationPath Condition="'$(LocalizationPath)' == ''">..\..\src\smart_search\assets\i18n\messages.json</LocalizationPath>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(LocalizationPath)" LogicalName="SmartSearch.Localizations.json" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <Content Include="Assets\smart-search.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\smart-search.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishCompiledXaml" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_CompiledXaml Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="@(_CompiledXaml)">
        <RelativePath>%(_CompiledXaml.RecursiveDir)%(_CompiledXaml.Filename)%(_CompiledXaml.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
